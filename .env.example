# =============================================================================
# .env.example — template for the secrets this app needs at runtime.
# -----------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored — never commit your real key.
#
# Obtain a Gemini API key from https://aistudio.google.com/apikey
# (sign in with your Google account, click "Create API key").
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here
